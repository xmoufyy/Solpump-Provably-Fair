{
  "name": "solpump-fairness-lab",
  "version": "2.0.0",
  "private": true,
  "description": "Independent provably-fair verification & auditing lab for Solpump Crash, Blackjack, Keno and Mines.",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c magenta,cyan \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build -w frontend",
    "start": "npm run start -w backend",
    "typecheck": "npm run typecheck -w backend && npm run typecheck -w frontend",
    "lint": "eslint .",
    "test": "npm run test -w backend",
    "test:integration": "npm run test:integration -w backend",
    "test:parity": "npm run test:parity -w backend",
    "test:e2e": "npm run test:e2e -w frontend",
    "bench": "npm run bench -w backend",
    "audit:all": "node scripts/audit-all.mjs",
    "build:api": "esbuild backend/src/vercel.ts --bundle --platform=node --target=node22 --format=esm --packages=external --sourcemap --outfile=backend/dist/vercel.mjs",
    "build:vercel": "npm run build && npm run build:api"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "esbuild": "0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "typescript-eslint": "^8.71.2"
  }
}
