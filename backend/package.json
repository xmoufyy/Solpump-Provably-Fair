    "@fastify/static": "^10.1.6",
    "fastify": "^5.2.1",
    "pdfkit": "^0.16.0",
    "seedrandom": "3.0.5",
    "tsx": "^4.19.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/pdfkit": "^0.13.8",
    "@types/seedrandom": "^3.0.8",
    "typescript": "^5.7.3",
    "vitest": "^5.0.5"
  }
}
