{
  "name": "@sfl/backend",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --disable-warning=ExperimentalWarning --import tsx --watch src/server.ts",
    "start": "node --disable-warning=ExperimentalWarning --import tsx src/server.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:parity": "node --disable-warning=ExperimentalWarning --import tsx ../tests/reference-parity/run.ts",
    "bench": "node --disable-warning=ExperimentalWarning --expose-gc --max-old-space-size=8192 --import tsx bench/bench.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.6",
    "@libsql/client": "^0.18.0",
    "fastify": "^5.2.1",
    "pdfkit": "^0.16.0",
    "seedrandom": "3.0.5",
    "tsx": "^4.19.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/pdfkit": "^0.13.8",
    "@types/seedrandom": "^3.0.8",
    "typescript": "^5.7.3",
    "vitest": "^5.0.5"
  }
}
